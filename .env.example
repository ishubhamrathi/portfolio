# Backend API root (single source of truth — no local fallback anymore)
VITE_API_BASE=http://localhost:8080

# API key for third-party platform API calls (GitHub, LeetCode stats, etc.).
# Must be VITE_-prefixed to reach import.meta.env. Never commit the real value.
VITE_PLATFORM_API_KEY=

# Experimental: one section per wheel swipe (fling skips to end). Disabled by default.
VITE_USE_SECTION_SCROLL=false
